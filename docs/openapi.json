{
  "openapi": "3.1.0",
  "info": {
    "title": "Сохраняя главное — экспериментальный прогноз ЧСС",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/forecasts/heart-rate": {
      "post": {
        "summary": "Forecast",
        "operationId": "forecast_v1_forecasts_heart_rate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForecastRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid service credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type or compression",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid schema or data quality",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Inference capacity is busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Model unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ForecastPoint": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "p10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P10"
          },
          "p50": {
            "type": "number",
            "title": "P50"
          },
          "p90": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P90"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "p10",
          "p50",
          "p90"
        ],
        "title": "ForecastPoint"
      },
      "ForecastRequest": {
        "properties": {
          "series_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Series Id"
          },
          "data_kind": {
            "type": "string",
            "enum": [
              "synthetic",
              "device"
            ],
            "title": "Data Kind"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/Measurement"
            },
            "type": "array",
            "maxItems": 576,
            "minItems": 288,
            "title": "Measurements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series_id",
          "data_kind",
          "measurements"
        ],
        "title": "ForecastRequest"
      },
      "ForecastResponse": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "data_kind": {
            "type": "string",
            "enum": [
              "synthetic",
              "device"
            ],
            "title": "Data Kind"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "forecast_origin": {
            "type": "string",
            "format": "date-time",
            "title": "Forecast Origin"
          },
          "interval_minutes": {
            "type": "integer",
            "title": "Interval Minutes"
          },
          "horizon_minutes": {
            "type": "integer",
            "title": "Horizon Minutes"
          },
          "input_points": {
            "type": "integer",
            "title": "Input Points"
          },
          "history_points_used": {
            "type": "integer",
            "title": "History Points Used"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 12,
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series_id",
          "data_kind",
          "generated_at",
          "forecast_origin",
          "interval_minutes",
          "horizon_minutes",
          "input_points",
          "history_points_used",
          "model",
          "points"
        ],
        "title": "ForecastResponse"
      },
      "Measurement": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "heart_rate_bpm": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Heart Rate Bpm"
          },
          "quality": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "unknown"
            ],
            "title": "Quality"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "heart_rate_bpm",
          "quality"
        ],
        "title": "Measurement"
      },
      "ModelInfo": {
        "properties": {
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "clinical_validity": {
            "type": "string",
            "const": "not_evaluated",
            "title": "Clinical Validity",
            "default": "not_evaluated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "backend",
          "revision"
        ],
        "title": "ModelInfo"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
